# Leave unset (or set to /api) so the client uses the current origin.
# Vite proxies /api and /ws to the local API. Docker nginx does the same.
# Absolute URL only when the API is on another host (for example Render):
# VITE_API_URL=https://your-api.example.com
VITE_API_URL=/api

# Optional. If empty, derived from window.location (http→ws, https→wss).
VITE_WS_URL=

# MapGL key. Leave empty locally if unused. Never commit a real key.
VITE_2GIS_API_KEY=
