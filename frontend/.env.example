# Local default. Production Render build must set:
# VITE_API_URL=https://project-atlas-5pf3.onrender.com
VITE_API_URL=http://localhost:8001

# Optional. If empty, derived from VITE_API_URL (http→ws, https→wss).
VITE_WS_URL=

# MapGL key. Leave empty locally if unused. Never commit a real key.
VITE_2GIS_API_KEY=
