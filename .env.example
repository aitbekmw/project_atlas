PROJECT_NAME=Atlas API
VERSION=1.0.0

# Managed Postgres. postgres:// and postgresql:// are accepted and converted to asyncpg.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME_TEST
DATABASE_ECHO=false
TESTING=false

# JWT signing key. Generate a long random value for production.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=atlas-api
JWT_AUDIENCE=atlas-users

# redis:// for local, rediss:// for TLS-managed Redis.
REDIS_URL=redis://HOST:6379/0

# S3-compatible storage. Browser presign host must not be a Docker-only DNS name.
MINIO_ENDPOINT=s3.example.com
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=avatars
MINIO_SECURE=true
MINIO_PUBLIC_ENDPOINT=s3.example.com
MINIO_PRESIGN_EXPIRES_SECONDS=604800

# Comma-separated or JSON list. Include the production frontend HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://atlas-frontend-2a9s.onrender.com

# Optional SMTP for email verification codes. Leave empty to skip sending in local/dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_RESEND_SECONDS=60
ENVIRONMENT=development

# Google OAuth. Leave empty until Cloud Console credentials are created.
# Local: http://localhost:8001/auth/google/callback
# LAN via nginx: http://<LAN-IP>/auth/google/callback (Google still needs a public redirect for phones)
# Tunnel/production: set the public https callback; do not hardcode tunnel hosts in app source.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# Used as a Docker build-arg for the frontend image (2GIS MapGL). Optional.
VITE_2GIS_API_KEY=
