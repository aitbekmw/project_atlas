PROJECT_NAME=Atlas API
VERSION=1.0.0

# Managed Postgres. postgres:// and postgresql:// are accepted and converted to asyncpg.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME_TEST
DATABASE_ECHO=false
TESTING=false

# JWT signing key. Generate a long random value for production.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=atlas-api
JWT_AUDIENCE=atlas-users

# redis:// for local, rediss:// for TLS-managed Redis.
REDIS_URL=redis://HOST:6379/0

# S3-compatible storage. Browser presign host must not be a Docker-only DNS name.
MINIO_ENDPOINT=s3.example.com
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=avatars
MINIO_SECURE=true
MINIO_PUBLIC_ENDPOINT=s3.example.com
MINIO_PRESIGN_EXPIRES_SECONDS=604800

# Comma-separated or JSON list. Include the production frontend HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
